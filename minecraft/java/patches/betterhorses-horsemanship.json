{
  "file": "/data/plugins/BetterHorses/config.yml",
  "ops": [
    {
      "$put": {
        "path": "$.max-stats",
        "key": "health",
        "value": 100.0
      }
    },
    {
      "$put": {
        "path": "$.max-stats",
        "key": "speed",
        "value": 0.79064
      }
    },
    {
      "$put": {
        "path": "$.max-stats",
        "key": "jump",
        "value": 1.3
      }
    },
    {
      "$put": {
        "path": "$['horse-growth-settings']",
        "key": "time-until-adult",
        "value": 60
      }
    },
    {
      "$put": {
        "path": "$.settings",
        "key": "breeding-cooldown",
        "value": 21600
      }
    },
    {
      "$put": {
        "path": "$.settings",
        "key": "male-ignore-cooldown",
        "value": true
      }
    },
    {
      "$set": {
        "path": "$.settings['mounted-damage-boost'].enabled",
        "value": false
      }
    }
  ]
}
