{
  "file": "/data/plugins/DeadChest/config.yml",
  "ops": [
    {
      "$put": {
        "path": "$.chest",
        "key": "duration-seconds",
        "value": 0
      }
    },
    {
      "$put": {
        "path": "$",
        "key": "updates",
        "value": {
          "auto-check": false
        }
      }
    },
    {
      "$put": {
        "path": "$",
        "key": "auto-update",
        "value": false
      }
    }
  ]
}
